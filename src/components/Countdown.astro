---
import Icon from './Icon.astro';
import { sides, after } from '../data/wedding';
const units = [
  { k: 'd', l: 'Ngày' },
  { k: 'h', l: 'Giờ' },
  { k: 'm', l: 'Phút' },
  { k: 's', l: 'Giây' },
];
---
<section class="cd" aria-label="Đếm ngược" data-countdown data-nam={sides.nam.countdown.iso} data-nu={sides.nu.countdown.iso} data-live-from={after.liveFrom} data-live-to={after.liveTo}>
  <div class="wrap cd__in">
    <p class="script cd__script" data-fade>Save the date</p>
    <div class="cd__grid" data-cd-before>
      {units.map((u) => (
        <div><b class="num" data-cd={u.k}>00</b><span>{u.l}</span></div>
      ))}
    </div>
    <p class="cd__label" data-cd-before>đến <span class="only-nam">{sides.nam.countdown.label}</span><span class="only-nu">{sides.nu.countdown.label}</span></p>
    {after.livestreamUrl && (
      <a class="btn cd__live" href={after.livestreamUrl} target="_blank" rel="noopener" data-cd-live hidden><i class="cd__dot"></i> Đang phát trực tiếp · Xem ngay</a>
    )}
    <!-- Sau ngày cưới: tự hiện khi đã qua giờ đếm ngược -->
    <div class="cd__after" data-cd-after hidden>
      <p class="cd__after-title">Cảm ơn bạn đã đến chung vui!</p>
      <p class="cd__after-text">Những khoảnh khắc của ngày hôm ấy, chúng mình gửi lại ở đây.</p>
      <div class="cd__after-btns">
        {after.albumUrl
          ? <a class="btn cd__btn" href={after.albumUrl} target="_blank" rel="noopener"><Icon name="arrow" /> Xem album ảnh cưới</a>
          : <span class="cd__soon">Album ảnh cưới sẽ được cập nhật tại đây</span>}
        {after.livestreamUrl && <a class="btn cd__btn cd__btn--line" href={after.livestreamUrl} target="_blank" rel="noopener"><Icon name="play" /> Xem lại livestream</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cd { background: var(--c-oxblood); color: var(--c-porcelain); padding: calc(var(--section-y) * .8) 0; }
  .cd__in { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .cd__script { font-size: clamp(3rem, 2.4rem + 3vw, 6rem); color: var(--c-champagne); }
  .cd__grid { width: 100%; max-width: 900px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cd__grid > div { display: flex; flex-direction: column; gap: 6px; }
  .cd__grid > div + div { border-left: 1px solid rgb(234 217 185 / .3); }
  .cd__grid b { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-weight: 400; font-size: clamp(2.75rem, 2rem + 4vw, 7rem); line-height: 1; }
  .cd__grid span { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--c-champagne); }
  .cd__label { font-size: 13px; color: var(--c-champagne); }
  [hidden] { display: none !important; }
  .cd__live { background: #C0392B; color: #fff; border-color: transparent; }
  .cd__dot { width: 8px; height: 8px; border-radius: 999px; background: #fff; animation: blink 1.2s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .2; } }
  .cd__after { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .cd__after-title { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-style: italic; font-size: clamp(2rem, 1.6rem + 2.4vw, 4rem); line-height: 1.1; }
  .cd__after-text { font-size: 15px; color: var(--c-champagne); max-width: 36ch; }
  .cd__after-btns { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 6px; }
  .cd__btn { background: var(--c-champagne); color: var(--c-oxblood); }
  .cd__btn--line { background: transparent; color: var(--c-champagne); border-color: var(--c-champagne); }
  .cd__soon { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--c-champagne); border: 1px dashed rgb(234 217 185 / .5); border-radius: 999px; padding: 12px 20px; }
</style>
