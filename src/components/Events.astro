---
import Icon from './Icon.astro';
import { sides, mapsUrl, calendarUrl, icsUrl, type SideKey } from '../data/wedding';
const keys: SideKey[] = ['nu', 'nam'];
---
<section class="ev" id="su-kien">
  <div class="wrap">
    <div class="ev__head">
      <div class="ev__title">
        <p class="eyebrow">03 / 04 — Sự kiện</p>
        <h2 class="h2" data-split>Lịch trình <em class="it">ngày vui</em></h2>
      </div>
      <p class="ev__lead" data-fade>Hôn lễ được tổ chức tại hai nơi. Chọn bên mời bạn để xem giờ và địa điểm.</p>
    </div>

    <div class="ev__switch" role="group" aria-label="Chọn bên mời" data-fade>
      {keys.map((k) => (
        <button type="button" data-side-btn={k} aria-pressed={k === 'nam' ? 'true' : 'false'}>
          <strong>{sides[k].label}</strong><span>{sides[k].sub}</span>
        </button>
      ))}
    </div>

    {keys.map((k) => (
      <div class={`ev__cards only-${k}`}>
        {sides[k].events.map((e, i) => (
          <article class="card" style={`--i:${i}`} data-card>
            <div class="card__top">
              <span class="eyebrow">{String(i + 1).padStart(2, '0')} · {e.kind}</span>
              <span class="card__host">{e.host}</span>
            </div>
            <div class="card__date">
              <div><span class="muted">Vào lúc</span><b>{e.time}</b></div>
              <div class="card__day"><span>{e.weekday}</span><b class="num">{e.day}</b></div>
              <div><span class="muted">Tháng 12</span><b>Năm 2026</b></div>
            </div>
            <p class="card__lunar">({e.lunar})</p>
            <div class="card__venue">
              <h3>{e.venue}</h3>
              {e.hall && <p class="card__hall">{e.hall}</p>}
              <p class="muted">{e.addr}</p>
            </div>
            <div class="card__btns">
              <a class="btn btn--ink" href={mapsUrl(e.mapQuery)} target="_blank" rel="noopener"><Icon name="pin" /> Chỉ đường</a>
              <a class="btn btn--line" href={icsUrl(e)}><Icon name="cal" /> Thêm vào lịch</a>
            </div>
            <p class="card__gcal">Dùng Google Calendar? <a href={calendarUrl(e)} target="_blank" rel="noopener">Thêm vào Google Calendar</a></p>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .ev { background: var(--c-pine); color: var(--c-porcelain); padding: var(--section-y) 0; }
  .ev .eyebrow { color: var(--c-champagne); }
  .ev__head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
  .ev__title { display: flex; flex-direction: column; gap: 12px; }
  .ev .h2 em { color: var(--c-champagne); }
  .ev__lead { font-size: 15px; color: var(--c-champagne); max-width: 40ch; }
  .ev__switch { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; border: 1px solid rgb(234 217 185 / .5); border-radius: 999px; margin-bottom: 24px; max-width: 520px; }
  .ev__switch button { min-height: 56px; border: none; border-radius: 999px; background: transparent; color: var(--c-champagne); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; transition: background-color var(--d-ui) var(--ease-silk), color var(--d-ui) var(--ease-silk); }
  .ev__switch strong { font-size: 14px; font-weight: 600; }
  .ev__switch span { font-size: 11px; opacity: .8; }
  .ev__switch button[aria-pressed='true'] { background: var(--c-champagne); color: var(--c-pine); }

  .ev__cards { display: flex; flex-direction: column; gap: 16px; }
  .card { position: sticky; top: calc(84px + var(--i) * 16px); background: var(--c-porcelain); color: var(--c-ink); padding: 24px 20px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 -12px 32px rgb(0 0 0 / .12); }
  .card .eyebrow { color: var(--c-bordeaux); }
  .card__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .card__host { font-size: 12px; color: var(--c-graphite); }
  .card__date { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; text-align: center; border-block: 1px solid var(--c-mist-deep); padding: 14px 0; }
  .card__date > div { display: flex; flex-direction: column; gap: 2px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .card__date b { font-weight: 600; }
  .card__day { padding: 0 18px; border-inline: 1px solid var(--c-ink); align-items: center; }
  .card__day b { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-weight: 400; font-size: 56px; line-height: 1; letter-spacing: 0; }
  .card__lunar { font-size: 12px; font-style: italic; color: var(--c-graphite); text-align: center; }
  .card__venue { display: flex; flex-direction: column; gap: 4px; }
  .card__venue h3 { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-weight: 400; font-size: clamp(1.5rem, 1.3rem + .8vw, 2rem); line-height: 1.2; }
  .card__hall { font-style: italic; color: var(--c-bordeaux); font-size: 15px; }
  .card__venue p { font-size: 14px; line-height: 1.6; }
  .card__btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: auto; }
  .card__btns .btn { padding: 0 12px; font-size: 13px; }
  .card__gcal { font-size: 12px; color: var(--c-graphite); text-align: center; margin-top: -6px; }
  .card__gcal a { color: var(--c-bordeaux); }

  @media (min-width: 1024px) {
    .ev__head { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
    .ev__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .card { position: relative; top: auto; padding: 36px; box-shadow: none; }
    .card__day b { font-size: 72px; }
  }
</style>
