---
import Icon from './Icon.astro';
import { gifts } from '../data/wedding';
---
<section class="gf" id="mung-cuoi">
  <div class="wrap">
    <div class="gf__rule" data-fade>
      <span class="eyebrow num">04 / 04</span><i></i><span class="gf__lbl">Mừng cưới</span>
    </div>
    <h2 class="h2 gf__h" data-split>Gửi lời chúc <em class="it accent">đến</em> hai bạn</h2>
    <div class="gf__grid">
      {gifts.map((g, i) => (
        <article class="gf__card" data-fade>
          <p class="gf__who">{g.who}</p>
          <div class="gf__qr">{g.qr ? <img src={g.qr} alt={`Mã QR tài khoản ${g.who}`} width="160" height="160" loading="lazy" /> : <span>[MÃ QR]</span>}</div>
          <p class="gf__name">{g.name}</p>
          <p class="gf__acc num">{g.bank}<br />{g.account}</p>
          <button type="button" class="btn btn--line" data-copy={g.account}><Icon name="copy" /> Sao chép số TK</button>
        </article>
      ))}
    </div>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</section>

<style>
  .gf { padding: var(--section-y) 0; }
  .gf__rule { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
  .gf__rule i { flex: 1; height: 1px; background: var(--c-ink); }
  .gf__lbl { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; }
  .gf__h { margin-bottom: 32px; }
  .gf__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .gf__card { background: var(--c-mist); padding: 20px 14px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .gf__who { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--c-graphite); }
  .gf__qr { width: min(100%, 160px); aspect-ratio: 1; background: #fff; display: grid; place-items: center; font-size: 11px; color: var(--c-graphite); }
  .gf__qr img { width: 100%; height: 100%; }
  .gf__name { font-family: var(--f-display); font-size: 16px; line-height: 1.3; }
  .gf__acc { font-size: 12px; line-height: 1.5; }
  .gf__card .btn { width: 100%; padding: 0 10px; font-size: 12px; }
  .toast { position: fixed; left: 50%; bottom: max(24px, env(safe-area-inset-bottom)); z-index: 90; translate: -50% 0; background: var(--c-ink); color: var(--c-porcelain); font-size: 13px; padding: 12px 20px; border-radius: 999px; opacity: 0; transform: translateY(12px); transition: opacity var(--d-ui), transform var(--d-ui) var(--ease-silk); pointer-events: none; }
  .toast.is-on { opacity: 1; transform: none; }
  @media (min-width: 1024px) {
    .gf__grid { max-width: 880px; gap: 24px; }
    .gf__card { padding: 36px; }
    .gf__name { font-size: 22px; }
    .gf__acc { font-size: 14px; }
    .gf__card .btn { width: auto; padding: 0 24px; }
  }
</style>
