---
/**
 * Nhạc nền: đĩa than nổi ở góc phải dưới, QUAY khi đang phát (chậm dần rồi dừng khi tắt).
 * Tự phát khi vào trang (nếu trình duyệt chặn thì phát ở lần chạm/bấm đầu tiên). Bấm vào đĩa để tắt / bật.
 * Đổi bài: chép mp3 vào public/music/ rồi sửa media.music + media.musicTitle trong src/data/wedding.ts.
 */
import { media, pub } from '../data/wedding';
---
{media.music && (
  <div class="vinyl" data-music>
    {media.musicTitle && <span class="vinyl__title" data-music-title><span class="vinyl__note" aria-hidden="true">♪</span> {media.musicTitle}</span>}
    <button type="button" class="vinyl__btn" data-music-btn aria-label="Bật / tắt nhạc nền" aria-pressed="false">
      <span class="vinyl__pulse" aria-hidden="true"></span>
      <span class="vinyl__disc" data-music-disc aria-hidden="true">
        <span class="vinyl__label"><span>Đ</span><svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9.2-9.4C1.6 7.2 3.8 4 7 4c2 0 3.6 1.2 5 3 1.4-1.8 3-3 5-3 3.2 0 5.4 3.2 4.2 6.6C19.5 15.4 12 20 12 20z"/></svg><span>C</span></span>
      </span>
    </button>
    <audio data-music-audio src={pub(media.music)} loop preload="auto"></audio>
  </div>
)}
<style>
  .vinyl { position: fixed; right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 60; display: flex; align-items: center; gap: 10px; pointer-events: none; }
  .vinyl > * { pointer-events: auto; }
  .vinyl__title { max-width: 52vw; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 12px; letter-spacing: .04em; color: var(--c-champagne);
    background: rgb(13 13 14 / .72); padding: 8px 14px; border-radius: 999px; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    opacity: 0; transform: translateX(10px); transition: opacity .5s, transform .5s var(--ease-silk); pointer-events: none; }
  .vinyl.is-playing .vinyl__title.is-shown { opacity: 1; transform: none; }
  .vinyl__note { color: var(--c-blush); }
  .vinyl__btn { position: relative; width: 60px; height: 60px; padding: 0; border: 0; border-radius: 50%; background: none; cursor: pointer; display: grid; place-items: center; }
  .vinyl__btn > * { grid-area: 1 / 1; }
  /* đĩa than: rãnh + vệt sáng + nhãn giữa */
  .vinyl__disc { width: 60px; height: 60px; border-radius: 50%; position: relative; box-shadow: 0 10px 24px -8px rgb(0 0 0 / .6), 0 0 0 1px rgb(234 217 185 / .35);
    background:
      conic-gradient(from 30deg, rgb(255 255 255 / 0) 0 12%, rgb(255 255 255 / .16) 16%, rgb(255 255 255 / 0) 22% 62%, rgb(255 255 255 / .12) 66%, rgb(255 255 255 / 0) 72%),
      repeating-radial-gradient(circle, #141416 0 1.4px, #1E1F22 1.4px 2.6px);
    display: grid; place-items: center; will-change: transform; }
  .vinyl__label { width: 24px; height: 24px; border-radius: 50%; background: var(--c-bordeaux); color: var(--c-champagne); display: flex; align-items: center; justify-content: center; gap: 0;
    font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-size: 8px; line-height: 1; box-shadow: inset 0 0 0 1.5px rgb(234 217 185 / .5); position: relative; }
  .vinyl__label::after { content: ''; position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #0d0d0e; }
  .vinyl__label svg { width: 7px; height: 7px; fill: var(--c-blush); margin: 0 .5px; }
  .vinyl__label span { position: relative; top: -.5px; }
  /* gợi ý bật nhạc khi chưa phát */
  .vinyl__pulse { width: 60px; height: 60px; border-radius: 50%; border: 1.5px solid var(--c-champagne); animation: vpulse 2s ease-out infinite; pointer-events: none; }
  .vinyl.is-playing .vinyl__pulse, .vinyl.was-played .vinyl__pulse { display: none; }
  @keyframes vpulse { from { transform: scale(1); opacity: .8; } to { transform: scale(1.6); opacity: 0; } }
  .vinyl__btn:focus-visible { outline: 2px solid var(--c-champagne); outline-offset: 3px; }
  @media (min-width: 1024px) { .vinyl { right: 24px; bottom: 24px; } .vinyl__btn, .vinyl__disc, .vinyl__pulse { width: 68px; height: 68px; } .vinyl__label { width: 28px; height: 28px; font-size: 9px; } }
  @media (prefers-reduced-motion: reduce) { .vinyl__pulse { animation: none; display: none; } }
</style>
