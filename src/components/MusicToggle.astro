---
import Icon from './Icon.astro';
import { media } from '../data/wedding';
---
{media.music && (
  <>
    <button type="button" class="music" id="music-btn" aria-label="Bật / tắt nhạc nền" aria-pressed="false"><Icon name="music" size={18} /></button>
    <audio id="music" src={media.music} loop preload="none"></audio>
  </>
)}
<style>
  .music { position: fixed; right: var(--gutter); bottom: max(20px, env(safe-area-inset-bottom)); z-index: 60; width: 48px; height: 48px; border-radius: 999px; border: 1px solid rgb(234 217 185 / .6); background: rgb(13 13 14 / .7); color: var(--c-champagne); display: grid; place-items: center; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .music[aria-pressed='true'] { background: var(--c-champagne); color: var(--c-oxblood); }
</style>
