---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { album, media } from '../data/wedding';
const total = String(album.length).padStart(2, '0');
---
<section class="al" id="album" data-album>
  <div class="al__inner" data-album-inner>
    <div class="wrap al__head">
      <div class="al__title">
        <p class="eyebrow" data-fade>03 / 05 — Album</p>
        <h2 class="h2" data-split>Endlessly</h2>
      </div>
      <p class="al__hint num"><span class="al__hint-m">vuốt →</span><span class="al__hint-d">cuộn để xem</span></p>
    </div>
    <div class="al__track" data-track tabindex="0" role="region" aria-label="Album ảnh cưới">
      {album.map((a, i) => (
        <figure class={`al__item al__item--${i % 3}`} data-album-item>
          <Photo src={a.src} alt={a.alt} widths={[360, 540, 800, 1100]} sizes="(min-width: 1024px) 34vw, 70vw" pos={a.pos} class="al__ph" />
          <figcaption class="num">{String(i + 1).padStart(2, '0')} / {total}</figcaption>
        </figure>
      ))}
    </div>
    <div class="wrap al__foot">
      <span class="num" data-album-cur>01</span>
      <span class="al__bar"><i data-progress></i></span>
      <span class="num al__total">{total}</span>
      {media.heroVideoMp4 && (
        <a class="btn btn--line al__video" href={media.heroVideoMp4} target="_blank" rel="noopener"><Icon name="play" /> Xem video</a>
      )}
    </div>
  </div>
</section>

<style>
  .al { background: var(--c-ink); color: var(--c-porcelain); }
  .al__inner { padding: var(--section-y) 0 calc(var(--section-y) * .7); }
  .al .eyebrow { color: var(--c-blush); }
  .al__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 32px; }
  .al__title { display: flex; flex-direction: column; gap: 12px; }
  .al .h2 { text-transform: uppercase; }
  .al__hint { font-size: 12px; color: var(--c-champagne); }
  .al__hint-d { display: none; }
  .al__track {
    display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: none;
  }
  .al__track::-webkit-scrollbar { display: none; }
  .al__item { flex: none; width: 70vw; max-width: 340px; scroll-snap-align: start; position: relative; margin: 0; }
  .al__item :global(.al__ph) { width: 100%; aspect-ratio: 5 / 7; }
  .al__item figcaption { position: absolute; z-index: 2; left: 10px; bottom: 10px; font-size: 11px; letter-spacing: .1em; color: var(--c-porcelain); background: rgb(13 13 14 / .62); padding: 4px 10px; border-radius: 999px; }
  .al__foot { display: flex; align-items: center; gap: 14px; margin-top: 28px; font-size: 12px; flex-wrap: wrap; }
  .al__bar { flex: 1; height: 1px; background: rgb(247 246 242 / .2); }
  .al__bar i { display: block; height: 1px; background: var(--c-porcelain); transform-origin: left; transform: scaleX(.14); }
  .al__total { color: var(--c-champagne); }
  .al__video { width: 100%; color: var(--c-champagne); }

  @media (min-width: 1024px) {
    .al__inner { height: 100vh; padding: 0; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
    .al__hint-m { display: none; }
    .al__hint-d { display: inline; }
    .al__track { overflow: visible; scroll-snap-type: none; gap: 24px; align-items: center; width: max-content; will-change: transform; }
    .al__item { width: auto; max-width: none; }
    .al__item :global(.al__ph) { height: 56vh; width: calc(56vh * 5 / 7); aspect-ratio: auto; }
    .al__item--1 :global(.al__ph) { height: 46vh; width: calc(46vh * 4 / 5); }
    .al__item--2 { align-self: flex-end; }
    .al__video { width: auto; }
  }
</style>
