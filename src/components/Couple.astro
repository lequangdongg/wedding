---
import Photo from './Photo.astro';
import { couple, keep } from '../data/wedding';
// **chữ nhấn**: bỏ dấu ** khi hiển thị, gửi danh sách chữ nhấn cho JS (lật lên thành bản đỏ đô)
const plain = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '$1');
const marks = (t: string) => JSON.stringify([...t.matchAll(/\*\*(.+?)\*\*/g)].map((m) => m[1]));
const people = [
  { ...couple.groom, label: 'Chú rể', pos: '50% 18%' },
  { ...couple.bride, label: 'Cô dâu', pos: '45% 24%' },
];
---
<section class="cp" aria-label="Cô dâu và chú rể">
  <div class="wrap cp__grid">
    {people.map((p, i) => (
      <figure class={`cp__fig cp__fig--${i}`}>
        <div class="cp__arch" data-clip>
          <Photo src={p.photo} alt={`${p.label} ${p.full}`} widths={[360, 540, 720, 1000]} sizes="(min-width: 1024px) 30vw, 46vw" pos={p.pos} class="cp__ph" />
        </div>
        <figcaption data-fade>
          <span class="eyebrow">{p.label} · {p.role}</span>
          <span class="cp__name">{keep(p.full)}</span>
        </figcaption>
      </figure>
    ))}
    <header class="cp__head">
      <p class="eyebrow" data-fade>Since 2024</p>
      <h2 class="h2 cp__h" data-split>Chuyện của <em class="it accent">tụi mình</em></h2>
      <p class="cp__script script" data-fade>our story</p>
    </header>
  </div>
  <div class="wrap cp__story" data-story>
    {couple.story.map((para, i) => <p class:list={['cp__p', { 'cp__p--first': i === 0 }]} data-reveal data-hl={marks(para)}>{plain(para)}</p>)}
    <p class="cp__sign hand" data-fade>— Đông &amp; Châu</p>
  </div>
</section>

<style>
  .cp { padding-bottom: var(--section-y); overflow-x: clip; }
  .cp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }
  .cp__fig { display: flex; flex-direction: column; gap: 12px; }
  .cp__fig--1 { padding-top: 56px; }
  .cp__arch { aspect-ratio: 3 / 4.3; border-radius: 999px 999px 0 0; overflow: hidden; }
  .cp__arch :global(.cp__ph) { width: 100%; height: 100%; }
  .cp__fig figcaption { display: flex; flex-direction: column; gap: 4px; }
  .cp__fig .eyebrow { color: var(--c-graphite); }
  .cp__name { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-size: clamp(1.25rem, 1rem + 1.2vw, 2.25rem); line-height: 1.2; }
  .cp__head { grid-column: 1 / -1; grid-row: 1; order: -1; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 20px; }
  .cp__h { font-size: clamp(2.5rem, 1.8rem + 3vw, 5rem); }
  .cp__script { font-size: clamp(2.25rem, 1.8rem + 2vw, 4rem); color: var(--c-blush); margin-top: -.35em; transform: rotate(-4deg); }
  .cp__fig--0 { grid-row: 2; } .cp__fig--1 { grid-row: 2; }
  /* Đoạn chuyện tình: chữ hiện dần theo cuộn (scroll.ts -> [data-reveal]) */
  .cp__story { max-width: 1100px; margin-top: clamp(48px, 8vw, 120px); display: flex; flex-direction: column; gap: 1.1em;
    font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-weight: 500; font-size: clamp(1.45rem, 1.05rem + 1.9vw, 2.75rem); line-height: 1.42; letter-spacing: -.005em; color: var(--c-ink); }
  .cp__p :global(.ln) { padding-block: .12em; margin-block: -.12em; } /* chừa chỗ cho dấu tiếng Việt khi che dòng */
  /* chữ nhấn: 2 bản xếp chồng, bản dưới (đỏ đô, nghiêng) lật lên thay bản trên */
  .cp__p :global(.roll) { display: inline-block; position: relative; vertical-align: top; overflow: visible clip; padding-block: .14em; margin-block: -.14em; }
  .cp__p :global(.roll > span) { display: block; white-space: nowrap; }
  .cp__p :global(.roll > span + span) { position: absolute; left: 0; top: .14em; color: var(--c-bordeaux); font-style: italic; }
  .cp__sign { align-self: flex-end; font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.6rem); color: var(--c-bordeaux); }
  @media (min-width: 1024px) {
    .cp__grid { grid-template-columns: 1fr 1fr 1fr; gap: 48px; align-items: center; }
    .cp__fig--0 { grid-column: 1; grid-row: 1; }
    .cp__fig--1 { grid-column: 3; grid-row: 1; padding-top: 160px; }
    .cp__head { grid-column: 2; grid-row: 1; margin: 0; }
  }
</style>
