---
/**
 * Ảnh có placeholder: hiện bản mờ siêu nhỏ (LQIP, nhúng sẵn trong HTML) + nền màu,
 * ảnh thật (AVIF/WebP nhiều kích thước) mờ dần lên khi tải xong.
 * Khung (.ph) quyết định kích thước — đặt width/height/aspect-ratio từ bên ngoài qua `class`/`style`.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import lqip from '../data/lqip.json';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  pos?: string;
  /** 'contain' (mặc định) = luôn thấy trọn ảnh, không cắt người; phần trống là chính ảnh làm mờ */
  fit?: 'contain' | 'cover';
  quality?: number;
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { src, alt, widths = [400, 640, 960, 1400], sizes = '100vw', eager = false, pos = '50% 50%', quality = 70, fit = 'contain', class: cls = '', style = '', ...rest } = Astro.props;
const key = (src.src.split('/').pop() || '').split('?')[0].split('.')[0];
const placeholder = (lqip as Record<string, string>)[key];
---
<div class:list={['ph', cls, { 'ph--eager': eager }]} style={`--pos:${pos};--fit:${fit};${placeholder ? `--lqip:url(${placeholder});` : ''}${style}`} {...rest}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</div>

<style>
  .ph { position: relative; overflow: hidden; background-color: #CBD5D3; isolation: isolate; }
  .ph::before {
    content: ''; position: absolute; inset: -12%; z-index: 0;
    background: var(--lqip, none) var(--pos) / cover no-repeat;
    filter: blur(18px) saturate(1.1); transform: scale(1.08);
  }
  .ph::after { /* vệt sáng chạy khi đang tải */
    content: ''; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / .22) 50%, transparent 70%) -150% 0 / 200% 100% no-repeat;
    animation: shimmer 1.6s linear infinite;
  }
  .ph.is-loaded::after { animation: none; opacity: 0; }
  .ph :global(picture) { display: contents; }
  .ph :global(img) {
    position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: var(--fit, contain); object-position: var(--pos);
    opacity: 0; transition: opacity .9s cubic-bezier(.33, 1, .68, 1);
  }
  .ph.is-loaded :global(img), :global(.no-js) .ph :global(img) { opacity: 1; }
  /* ảnh đầu trang: hiện ngay khi giải mã xong (không mờ dần) -> LCP sớm */
  .ph--eager :global(img) { opacity: 1; transition: none; }
  @keyframes shimmer { to { background-position: 250% 0; } }
  @media (prefers-reduced-motion: reduce) { .ph::after { animation: none; } }
</style>
