---
/**
 * KHOẢNH KHẮC — xấp polaroid lớn, cuộn tới đâu ảnh bay vào tới đó rồi xoè quạt sang hai bên
 * (cảm hứng từ phần "Tour dates" của trang mẫu). Không có chú thích dưới ảnh.
 */
import Photo from './Photo.astro';
import { moments } from '../data/wedding';
const total = String(moments.length).padStart(2, '0');
---
<section class="tour" id="khoanh-khac" data-tour aria-label="Khoảnh khắc">
  <div class="tour__pin" data-tour-pin>
    <h2 class="tour__title hand" data-tour-title>Khoảnh khắc</h2>
    <p class="tour__meta"><span class="eyebrow">02 / 04</span><span class="num"><b data-tour-cur>01</b> / {total}</span></p>
    <div class="tour__stage" data-tour-stage>
      {moments.map((m, i) => (
        <figure class="pol" data-pol style={`z-index:${i + 1}`}>
          <Photo src={m.photo} alt={m.alt} widths={[480, 720, 1080, 1440]} sizes="(min-width: 1024px) 40vw, 84vw" pos={m.pos} class="pol__ph" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .tour { background: #0B0B0C; color: var(--c-porcelain); }
  .tour__pin { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
  .tour__title {
    position: absolute; left: max(4px, calc(var(--gutter) - 18px)); top: 50%; z-index: 0; margin: 0;
    writing-mode: vertical-rl; transform: translateY(-50%) rotate(180deg); white-space: nowrap;
    font-size: clamp(3.5rem, 12svh, 12rem); line-height: .82; letter-spacing: .01em; text-transform: uppercase; color: #E8784A;
  }
  .tour__meta { position: absolute; z-index: 20; top: calc(76px + env(safe-area-inset-top)); right: var(--gutter); display: flex; gap: 14px; align-items: baseline; font-size: 12px; color: var(--c-champagne); }
  .tour__meta .eyebrow { color: #E8784A; }
  .tour__meta b { font-weight: 500; color: var(--c-porcelain); }
  .tour__stage { position: absolute; inset: 0; z-index: 1; }
  /* Polaroid lớn, khung tối như ảnh mẫu */
  .pol {
    --w: min(76vw, 500px);
    position: absolute; left: 56%; top: 52%; margin: 0; width: var(--w);
    transform: translate(-50%, -50%);
    background: #161616; padding: calc(var(--w) * .035) calc(var(--w) * .035) calc(var(--w) * .2);
    border-radius: 8px; border: 1px solid rgb(255 255 255 / .06);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / .85), 0 12px 24px -12px rgb(0 0 0 / .6);
  }
  .pol :global(.pol__ph) { width: 100%; aspect-ratio: 1 / 1.02; border-radius: 3px; }
  @media (min-width: 768px) {
    .pol { --w: min(58vw, 560px); left: 53%; }
  }
  @media (min-width: 1024px) {
    .tour__meta { top: 112px; }
    .pol { --w: clamp(360px, min(38vw, 74vh), 760px); top: 50%; left: 52%; padding-bottom: calc(var(--w) * .17); }
    .pol :global(.pol__ph) { aspect-ratio: 1.24 / 1; }
  }
</style>
