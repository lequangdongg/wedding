---
import Photo from './Photo.astro';
import { photos, media, site, pub } from '../data/wedding';
// Tách chữ sẵn lúc build (không cần SplitText ở trình duyệt) -> intro nhẹ hơn
// Mỗi tên là một cụm KHÔNG BAO GIỜ xuống dòng giữa chừng; cỡ chữ tự co theo bề ngang màn hình
const groups = [['Quang', 'Đông'], ['&'], ['Trang', 'Châu']];
const v = media.heroVideo;
const hasVideo = Boolean(v.mobile.mp4 || v.desktop.mp4);
---
<section class="hero" id="top" aria-label="Quang Đông và Trang Châu">
  <div class="hero__frame" data-hero-frame>
    <div class="hero__media" data-hero-media>
      <Photo
        src={photos.studioCouple}
        alt="Quang Đông và Trang Châu trong bộ ảnh cưới"
        widths={[480, 720, 1080, 1440]}
        sizes="(min-aspect-ratio: 1987/2400) 83vh, 100vw"
        eager
        pos="50% 30%"
        quality={58}
        class="hero__ph"
      />
      {hasVideo && (
        <video class="hero__video" data-hero-video muted loop playsinline preload="none" aria-hidden="true"
          data-m-mp4={pub(v.mobile.mp4)} data-m-webm={pub(v.mobile.webm)} data-d-mp4={pub(v.desktop.mp4 ?? v.mobile.mp4)} data-d-webm={pub(v.desktop.webm ?? v.mobile.webm)}></video>
      )}
    </div>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__side hero__side--l" data-hero-fade>Till the<br />end</div>
  <div class="hero__side hero__side--r" data-hero-fade>Forever<br />with you</div>
  <p class="hero__book" data-hero-fade>The Love Book</p>

  <div class="hero__bottom" data-hero-bottom>
    <p class="hero__script script" aria-hidden="true" data-hero-script>Blooming day</p>
    <h1 class="hero__names" data-hero-title aria-label="Quang Đông và Trang Châu">
      {groups.map((g, gi) => (
        <span class:list={['nm', { 'nm--amp': g[0] === '&' }]} aria-hidden="true">
          {g.map((w) => (
            <span class="w">{w === '&' ? <em class="c">&amp;</em> : [...w].map((ch) => <span class="c">{ch}</span>)}</span>
          ))}
        </span>
      ))}
    </h1>
    <div class="hero__meta" data-hero-fade>
      <span class="num">{site.dateShort}<br />{site.city}</span>
      <span class="hero__cue" aria-hidden="true"><span>Cuộn</span><i></i></span>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 600px; overflow: clip; background: var(--c-ink); color: var(--c-porcelain); }
  .hero__frame { position: absolute; inset: 0; overflow: hidden; will-change: transform; }
  .hero__media { position: absolute; inset: 0; }
  .hero__media :global(.hero__ph) { position: absolute; inset: 0; }
  .hero__video { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s var(--ease-soft); }
  .hero__video.is-playing { opacity: 1; }
  /* Điện thoại: ảnh/video giữ nguyên cả khung (không cắt người), phần trống là ảnh làm mờ — khớp với video */
  @media (max-width: 1023px) {
    .hero__media :global(.hero__ph)::before { filter: blur(26px) brightness(.62); transform: scale(1.25); }
  }
  /* màn hình điện thoại thấp / máy tính bảng (rộng hơn 3:5): video hiện TRỌN khung, không cắt người; viền là ảnh mờ phía sau */
  @media (max-width: 1023px) and (min-aspect-ratio: 3/5) {
    .hero__video { object-fit: contain; }
  }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(23 24 26 / .45) 0%, rgb(23 24 26 / 0) 26%, rgb(23 24 26 / 0) 46%, rgb(23 24 26 / .78) 100%); pointer-events: none; }

  .hero__side { position: absolute; top: calc(88px + env(safe-area-inset-top)); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; line-height: 1.6; }
  .hero__side--l { left: var(--gutter); }
  .hero__side--r { right: var(--gutter); text-align: right; }
  .hero__book { display: none; }

  .hero__bottom { position: absolute; left: var(--gutter); right: var(--gutter); bottom: max(32px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 18px; }
  .hero__script { font-size: clamp(2.75rem, 2rem + 4vw, 8rem); color: var(--c-champagne); transform: rotate(-4deg); transform-origin: left; margin-bottom: -8px; }
  .hero__names { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-weight: 400; font-size: min(5rem, calc((100vw - 2 * var(--gutter)) / 7.9)); line-height: .98; letter-spacing: -.02em; text-transform: uppercase; }
  .hero__names .nm { display: block; white-space: nowrap; }
  .hero__names .nm--amp { line-height: .8; }
  .hero__names .nm .w:last-child { margin-right: 0; }
  .hero__names em { font-style: italic; text-transform: none; color: var(--c-blush); }
  .hero__names .w { display: inline-block; overflow: clip; padding: .08em 0 .04em; margin: -.08em .24em -.04em 0; vertical-align: top; }
  .hero__names .c { display: inline-block; }
  .hero__meta { display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid rgb(247 246 242 / .5); padding-top: 14px; font-size: 13px; line-height: 1.5; }
  .hero__cue { display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; }
  .hero__cue i { width: 1px; height: 40px; background: rgb(247 246 242 / .3); position: relative; overflow: hidden; }
  .hero__cue i::after { content: ''; position: absolute; inset: 0; background: var(--c-porcelain); animation: cue 2.2s var(--ease-curtain) infinite; }
  @keyframes cue { 0% { transform: translateY(-100%); } 50% { transform: none; } 100% { transform: translateY(100%); } }

  @media (min-width: 1024px) {
    .hero { min-height: 600px; }
    /* Máy tính: video ghép ảnh tràn toàn màn hình (3 cột ảnh) */
    .hero__video { object-position: 50% 0%; } /* màn hình thấp hơn 16:9 thì cắt phía dưới, không cắt đầu */
    .hero__scrim { background: linear-gradient(180deg, rgb(23 24 26 / .5) 0%, rgb(23 24 26 / .08) 26%, rgb(23 24 26 / .1) 48%, rgb(23 24 26 / .72) 100%); }
    .hero__side { top: 140px; font-size: 13px; }
    .hero__book { display: block; position: absolute; top: 112px; left: 0; right: 0; text-align: center; font-size: 13px; letter-spacing: .24em; text-transform: uppercase; }
    .hero__bottom { bottom: 48px; }
    .hero__script { position: absolute; left: 6vw; bottom: calc(100% + 12vh); margin: 0; transform: rotate(-6deg); }
    /* "QUANG ĐÔNG &" một dòng, "TRANG CHÂU" một dòng — không bao giờ tách tên */
    .hero__names { text-align: center; font-size: min(var(--t-display), calc((100vw - 2 * var(--gutter)) / 9), 18svh); line-height: .92; }
    .hero__names .nm { display: inline-block; vertical-align: top; }
    .hero__names .nm--amp { line-height: inherit; margin-left: .2em; }
    .hero__names .nm:last-child { display: block; }
    .hero__meta { border-top: none; padding-top: 0; position: absolute; left: 0; right: 0; bottom: calc(100% + 32px); font-size: 14px; }
  }
</style>
