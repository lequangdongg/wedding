---
import { families, sides, keep } from '../data/wedding';
---
<section class="inv" id="loi-moi">
  <div class="wrap inv__in">
    <p class="eyebrow" data-fade>01 / 05 — Trân trọng kính mời</p>
    <p class="inv__guest" data-guest hidden>
      <span class="inv__guest-label">Kính gửi</span>
      <span class="inv__guest-name" data-guest-name></span>
    </p>
    <h2 class="h2" data-split>Đến chung vui <em class="it accent">cùng</em> gia đình chúng tôi</h2>
    <div class="inv__fams">
      {(['nam', 'nu'] as const).map((k, i) => (
        <div class={`fam fam--${k}`} data-fade>
          <p class="eyebrow">{families[k].side}</p>
          <p class="fam__names">Ông {keep(families[k].father)}<br />Bà {keep(families[k].mother)}</p>
          <p class="fam__addr muted">{families[k].addr}</p>
        </div>
      ))}
    </div>
    <p class="inv__news" data-fade>
      Trân trọng báo tin <strong class="only-nam">{sides.nam.ceremony}</strong><strong class="only-nu">{sides.nu.ceremony}</strong><br />của hai con chúng tôi
    </p>
    <p class="inv__honor" data-fade>Sự hiện diện của Quý Khách là niềm vinh hạnh cho gia đình chúng tôi!</p>
  </div>
</section>

<style>
  .inv { padding: var(--section-y) 0 calc(var(--section-y) * .6); text-align: center; }
  .inv__in { max-width: 920px; display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .inv .h2 { font-size: clamp(2.75rem, 2rem + 3.4vw, 5.75rem); line-height: 1.02; }
  .inv__guest { display: flex; flex-direction: column; align-items: center; gap: 6px; margin: 4px 0 8px; }
  .inv__guest[hidden] { display: none; }
  .inv__guest-label { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--c-graphite); }
  .inv__guest-name { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-style: italic; font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem); line-height: 1.2; color: var(--c-bordeaux); padding: 0 .4em .15em; border-bottom: 2px dotted var(--c-mist-deep); }
  .inv__fams { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 8px; }
  :global(html[data-side='nu']) .fam--nu { order: -1; }
  .fam { border-top: 1px solid var(--c-ink); padding-top: 14px; display: flex; flex-direction: column; gap: 6px; }
  /* Phần trang trọng nhất: tên cha mẹ, lễ, lời mời -> chữ Cormorant, cỡ lớn */
  .fam__names { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-weight: 600; font-size: 19px; line-height: 1.45; }
  .fam__addr { font-size: 13px; line-height: 1.55; }
  .inv__news { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-size: 17px; letter-spacing: .16em; text-transform: uppercase; line-height: 1.7; margin-top: 8px; }
  .inv__news strong { display: inline-block; font-weight: 600; font-size: 1.75em; letter-spacing: .1em; color: var(--c-bordeaux); margin: .2em 0; }
  .inv__honor { font-family: var(--f-display); font-size-adjust: var(--fsa-display); font-style: italic; font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem); line-height: 1.45; color: var(--c-ink); max-width: 28ch; }
  @media (min-width: 768px) {
    .inv__fams { gap: 64px; }
    .fam__names { font-size: 26px; }
    .fam__addr { font-size: 15px; }
    .inv__news { font-size: 20px; }
  }
</style>
