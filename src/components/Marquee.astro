---
import { site } from '../data/wedding';
const big = ['Save the date', 'Endlessly', 'Till the end'];
const small = `Quang Đông & Trang Châu · ${site.dateShort.replace(/ · /g, '.')} · ${site.city} ·`;
---
<div class="mq" aria-hidden="true">
  <div class="mq__row mq__row--big" data-marquee="1">
    {[0, 1].map(() => (
      <span>{big.map((w, i) => <>{w} · {i === 0 && <><em class="script">forever</em> · </>}</>)}</span>
    ))}
  </div>
  <div class="mq__row mq__row--small" data-marquee="-1">
    {[0, 1].map(() => <span>{small} {small} {small}</span>)}
  </div>
</div>

<style>
  .mq { background: var(--c-oxblood); color: var(--c-porcelain); padding: 28px 0; display: flex; flex-direction: column; gap: 12px; overflow: hidden; }
  .mq__row { display: flex; width: max-content; white-space: nowrap; will-change: transform; }
  .mq__row span { padding-right: .6em; }
  .mq__row--big { font-family: var(--f-display); font-size: clamp(2.75rem, 2rem + 4vw, 7rem); line-height: 1; text-transform: uppercase; }
  .mq__row--big em { font-style: normal; text-transform: none; color: var(--c-blush); font-size: 1.1em; }
  .mq__row--small { font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--c-champagne); }
</style>
