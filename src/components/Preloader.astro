---
import { Image } from 'astro:assets';
import { photos, site } from '../data/wedding';
---
{site.preloader && <div class="loader" id="loader" aria-hidden="true">
  <div class="loader__top"><span>The Love Book</span><span>{site.dateShort}</span></div>
  <div class="loader__mid">
    <div class="loader__oval" data-loader-oval>
      <Image src={photos.veil} alt="" widths={[200, 400]} sizes="200px" loading="eager" fetchpriority="high" quality={60} class="loader__img" />
    </div>
    <p class="loader__names" data-loader-names>
      <span>Quang Đông</span>
      <span class="script">and</span>
      <span>Trang Châu</span>
    </p>
  </div>
  <div class="loader__bottom">
    <span class="loader__hint">Đang chuẩn bị<br />thiệp mời của bạn…</span>
    <span class="loader__count num" id="loader-count">00</span>
  </div>
  <div class="loader__bar"><span id="loader-bar"></span></div>
</div>}

<style>
  .loader {
    position: fixed; inset: 0; z-index: 100; background: var(--c-oxblood); color: var(--c-porcelain);
    display: grid; grid-template-rows: auto 1fr auto auto; gap: 16px;
    padding: max(48px, env(safe-area-inset-top)) var(--gutter) 32px;
  }
  :global(.no-js) .loader, :global(.skip-loader) .loader { display: none; }
  .loader__top { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--c-champagne); }
  .loader__mid { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; }
  .loader__oval { width: clamp(140px, 14vw, 200px); aspect-ratio: 5 / 7; border-radius: 999px 999px 0 0; overflow: hidden; }
  .loader__oval { animation: ovalIn 1.6s var(--ease-silk) both; }
  .loader__oval :global(.loader__img) { width: 100%; height: 100%; object-fit: cover; object-position: 40% 30%; }
  @keyframes ovalIn { from { transform: scale(.82); border-radius: 999px; } }
  .loader__names { display: flex; flex-direction: column; align-items: center; text-align: center; font-family: var(--f-display); font-size: clamp(2.5rem, 2rem + 2.5vw, 4.5rem); line-height: 1.08; text-transform: uppercase; }
  .loader__names .script { color: var(--c-blush); text-transform: none; }
  .loader__names > * { animation: nameIn 1.3s var(--ease-silk) both; }
  .loader__names > :nth-child(2) { animation-delay: .08s; }
  .loader__names > :nth-child(3) { animation-delay: .16s; }
  @keyframes nameIn { from { transform: translateY(36px); } }
  .loader__bottom { display: flex; justify-content: space-between; align-items: flex-end; }
  .loader__hint { font-size: 12px; line-height: 1.5; color: var(--c-champagne); }
  .loader__count { font-family: var(--f-display); font-size: clamp(5rem, 4rem + 5vw, 9rem); line-height: .8; }
  .loader__bar { height: 1px; background: rgb(234 217 185 / .25); }
  .loader__bar span { display: block; height: 1px; background: var(--c-champagne); transform-origin: left; transform: scaleX(0); }
</style>
