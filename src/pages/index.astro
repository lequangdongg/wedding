---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Invitation from '../components/Invitation.astro';
import Couple from '../components/Couple.astro';
import Story from '../components/Story.astro';
import Events from '../components/Events.astro';
import Countdown from '../components/Countdown.astro';
import Gift from '../components/Gift.astro';
import Wishes from '../components/Wishes.astro';
import Footer from '../components/Footer.astro';
import MusicToggle from '../components/MusicToggle.astro';
---
<Base>
  <Preloader />
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Invitation />
    <Couple />
    <Story />
    <Events />
    <Countdown />
    <Gift />
    <Wishes />
  </main>
  <Footer />
  <MusicToggle />
</Base>
