---
import '../styles/global.css';
import { site } from '../data/wedding';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import displayFontVi from '@fontsource/cormorant-garamond/files/cormorant-garamond-vietnamese-500-normal.woff2?url';

interface Props { side?: 'nam' | 'nu'; title?: string; description?: string; ogImage?: string; noindex?: boolean }
const { side, title = site.title, description = site.description, ogImage = '/og.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const publicPath = import.meta.env.BASE_URL.replace(/\/$/, '');
const og = new URL(`${publicPath}${ogImage}`, Astro.site);
---
<!doctype html>
<html lang="vi" class="no-js" data-side={side}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#3B0A10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFontVi} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${publicPath}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${publicPath}/apple-touch-icon.png`} />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      try { if (sessionStorage.getItem('dc-seen')) document.documentElement.classList.add('skip-loader'); } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class="is-locked">
    <slot />
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
