---
import '../styles/global.css';
import { site } from '../data/wedding';

interface Props { side?: 'nam' | 'nu'; title?: string; description?: string; ogImage?: string; noindex?: boolean }
const { side, title = site.title, description = site.description, ogImage = '/og.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const publicPath = import.meta.env.BASE_URL.replace(/\/$/, '');
const og = new URL(`${publicPath}${ogImage}`, Astro.site);
---
<!doctype html>
<html lang="vi" class="no-js" data-side={side}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#3B0A10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${publicPath}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${publicPath}/apple-touch-icon.png`} />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      try { if (sessionStorage.getItem('dc-seen')) document.documentElement.classList.add('skip-loader'); } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class="is-locked">
    <slot />
    <script is:inline>
      // Tên khách (?ten=...) gắn ngay khi trang dựng xong, không chờ JS chính. Chịu được link gõ tay có "&" chưa mã hoá.
      (function () {
        var m = /[?&]ten=(.*?)(?=&(?:ben|now|utm_[a-z]+|fbclid|gclid|zarsrc)=|$)/i.exec(location.search);
        if (!m) return;
        var g = m[1].replace(/\+/g, ' ').replace(/=+$/, '');
        try { g = decodeURIComponent(g); } catch (e) { g = g.replace(/%26/gi, '&').replace(/%20/g, ' '); }
        g = g.replace(/[<>]/g, '').replace(/\s+/g, ' ').trim().slice(0, 80);
        if (!g) return;
        document.querySelectorAll('[data-guest-name]').forEach(function (el) { el.textContent = g; });
        document.querySelectorAll('[data-guest]').forEach(function (el) { el.hidden = false; });
        document.querySelectorAll('[data-no-guest]').forEach(function (el) { el.hidden = true; });
        document.documentElement.classList.add('has-guest');
        // chuẩn hoá lại link (mã hoá "&" trong tên) để khách chia sẻ/tải lại vẫn đúng
        try {
          var q = new URLSearchParams(); q.set('ten', g);
          var sp = new URLSearchParams(location.search);
          ['ben', 'now'].forEach(function (k) { if (sp.get(k)) q.set(k, sp.get(k)); });
          history.replaceState(null, '', location.pathname + '?' + q.toString() + location.hash);
        } catch (e) {}
      })();
    </script>
    <script>
      // JS chính (GSAP, màn chờ, hiệu ứng) tải SAU lần vẽ đầu tiên -> trang hiện ngay, không chờ ~30KB script
      requestAnimationFrame(() => setTimeout(() => import('../scripts/app.ts'), 0));
    </script>
  </body>
</html>
